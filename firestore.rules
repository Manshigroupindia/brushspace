rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for admin authentication
    function isAdmin() {
      return request.auth != null;
    }

    // Public catalog & content (Read-only for public, Full access for authenticated admins)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders & inquiries (Public can create an order inquiry, only admins can view/manage)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Customer inquiries (Public can submit contact inquiries, only admins can view/manage)
    match /customers/{customerId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
